# Copy this file to .env and add your key to switch on AI-written stories.
# Without it the app still works, using the built-in story engine.
# Get a key at https://platform.claude.com/ — keep .env private, never commit it.
ANTHROPIC_API_KEY=

# Optional: which Claude model writes the stories (default: claude-opus-5-5)
# STORY_MODEL=claude-opus-5-5

# --- Payments (Stripe) ---
# Without this key the checkout stays in demo mode and charges nothing.
# Use a TEST key (sk_test_…) first; switch to the live key (sk_live_…) only when ready.
# Find it in the Stripe dashboard under Developers > API keys. Never share or commit it.
STRIPE_SECRET_KEY=

# Printed books stay unavailable until you have a printer and a carrier.
# ENABLE_PRINT_ORDERS=true
# Countries the printed book ships to (ISO codes)
# SHIP_TO_COUNTRIES=FR,BE,CH,LU,CA
